# SoulPulse Test Environment Configuration
# Copy this file to .env.test and fill in real values
# DO NOT commit the populated .env.test to git.

# Runtime environment selector (production | test | dev)
ENV=test

# PostgreSQL async DSN for the isolated test database.
# Replace YOUR_PG_PASSWORD with the real DB password.
DATABASE_URL=postgresql+asyncpg://soulpulse:YOUR_PG_PASSWORD@postgres:5432/soulpulse_test

# JWT signing key. Test-only value — must still be replaced for production.
SECRET_KEY=test-secret-key-change-in-production

# Alibaba Cloud DashScope AI
# Issued from https://dashscope.console.aliyun.com
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
# Default chat model used by chat_service
DASHSCOPE_CHAT_MODEL=qwen-max
# Character/persona-tuned model
DASHSCOPE_CHARACTER_MODEL=qwen-plus-character
# Text-to-image model used by image generation pipeline
DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo

# Image Generation backend selector (nai | dashscope)
IMAGE_BACKEND=nai
# NovelAI API key, optional in the test environment
NAI_API_KEY=

# Alibaba Cloud OSS (optional - leave blank to use local static storage)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=

# CORS - comma-separated origins allowed to call the test API.
# Restrict to your test URL/port. Do NOT use "*".
ALLOWED_ORIGINS=http://YOUR_SERVER_IP:9080

# ChromaDB persistence directory (mounted volume in Docker)
CHROMA_PERSIST_DIRECTORY=./chroma_data
