# SoulPulse Production Environment Configuration
# Copy this file to .env.production and fill in real values
# DO NOT commit the populated .env.production to git.

# Runtime environment selector (production | test | dev)
ENV=production

# PostgreSQL async DSN consumed by SQLAlchemy.
# Replace YOUR_PG_PASSWORD with the real DB password.
DATABASE_URL=postgresql+asyncpg://soulpulse:YOUR_PG_PASSWORD@postgres:5432/soulpulse

# JWT signing key. MUST be a high-entropy random string (>= 64 chars).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING

# Alibaba Cloud DashScope AI
# Issued from https://dashscope.console.aliyun.com
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
# Default chat model used by chat_service
DASHSCOPE_CHAT_MODEL=qwen-max
# Character/persona-tuned model
DASHSCOPE_CHARACTER_MODEL=qwen-plus-character
# Text-to-image model used by image generation pipeline
DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo

# Image Generation backend selector (nai | dashscope)
IMAGE_BACKEND=nai
# NovelAI API key, only required when IMAGE_BACKEND=nai
NAI_API_KEY=your-novelai-api-key

# Alibaba Cloud OSS (optional - leave blank to use local static storage)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=

# CORS - comma-separated origins allowed to call the API.
# Restrict to your domain/IP in production. Do NOT use "*".
ALLOWED_ORIGINS=http://YOUR_SERVER_IP

# ChromaDB persistence directory (mounted volume in Docker)
CHROMA_PERSIST_DIRECTORY=./chroma_data
